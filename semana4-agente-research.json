    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of items) {\n  const { pregunta, idioma } = item.json.body;\n\n  if (!pregunta?.trim()) {\n    throw new Error('El campo pregunta es obligatorio');\n  }\n\n  item.json = {\n    pregunta:   pregunta.trim(),\n    idioma:     idioma?.trim() || 'es',\n    timestamp:  new Date().toISOString(),\n  };\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -528,
        -16
      ],
      "id": "cc16955d-0026-4d69-8021-a77aca3bd508",
