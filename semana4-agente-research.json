    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of items) {\n  const pages = item.json.query.pages;\n  const pageId = Object.keys(pages)[0];\n  const pagina = pages[pageId];\n\n  item.json = {\n    pregunta:  $('Validar entrada').first().json.pregunta,\n    idioma:    $('Validar entrada').first().json.idioma,\n    titulo:    pagina.title,\n    contenido: pagina.extract,\n    timestamp: $('Validar entrada').first().json.timestamp,\n  };\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        -16
      ],
      "id": "d39c71f9-4d82-413c-916c-3f3b99d01697",
      "name": "Preparar contexto"
    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of items) {\n  const texto = item.json.content[0].text;\n\n  let research;\n  try {\n    research = JSON.parse(texto);\n  } catch (e) {\n    research = {\n      respuesta: 'Error al procesar la respuesta',\n      puntos_clave: [],\n      fuente: 'desconocida',\n      confianza: 'baja'\n    };\n  }\n\n  item.json = {\n    pregunta:  $('Validar entrada').first().json.pregunta,\n    idioma:    $('Validar entrada').first().json.idioma,\n    research:  research,\n    timestamp: new Date().toISOString(),\n  };\n}\n\nreturn items;"
      },
